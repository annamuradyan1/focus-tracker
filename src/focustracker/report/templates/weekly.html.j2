<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Weekly focus report · {{ start.strftime("%d %b") }}–{{ end.strftime("%d %b %Y") }}</title>
<style>{{ css | safe }}</style>
</head>
<body>
<main>
<header>
  <h1>Weekly focus report</h1>
  <p>{{ start.strftime("%a %d %b") }} – {{ end.strftime("%a %d %b %Y") }}</p>
  {% if sample %}<span class="sample">Synthetic sample data</span>{% endif %}
</header>

<section class="summary">
  <h2>Summary</h2>
  <ul>{% for line in insights %}<li>{{ line }}</li>{% endfor %}</ul>
</section>

<section>
  <h2>Day by day</h2>
  <div class="scroll">
  <table>
    <tr><th>Day</th><th>Active</th><th>Switches/h</th><th>Micro/h</th><th>Median block</th><th>Clean focus</th><th>Returned</th></tr>
    {% for r in rows %}
    <tr>
      <td>{{ r.day.strftime("%a %d") }}</td>
      {% if r.m and r.m.stints %}
      <td>{{ "%.1f" | format(r.m.active_hours) }} h</td>
      <td>{{ "%.1f" | format(r.m.switches_per_hour) }}</td>
      <td>{{ "%.1f" | format(r.m.micro_per_hour) }}</td>
      <td>{{ "%.0f" | format(r.m.median_block_minutes) }} min</td>
      <td>{{ fmt_minutes(r.m.clean_focus[1].duration) if r.m.clean_focus else "–" }}</td>
      <td>{{ "%.0f%%" | format(100 * r.m.return_rate) if r.m.return_rate is not none else "–" }}</td>
      {% else %}
      <td colspan="6" style="text-align:left;color:var(--muted)">no data</td>
      {% endif %}
    </tr>
    {% endfor %}
  </table>
  </div>
</section>

<section>
  <h2>Task switches per active hour</h2>
  <div class="legend">{{ switch_legend }}</div>
  {{ switch_chart }}
</section>

<div class="cols-2">
  <section>
    <h2>Micro-interruptions per hour</h2>
    {{ micro_chart }}
  </section>
  <section>
    <h2>Median focus block (min)</h2>
    {{ block_chart }}
  </section>
</div>

<section>
  <h2>Longest clean focus per day (min)</h2>
  <p class="sub">The longest stretch on one task with no micro-interruption at all.</p>
  {{ clean_chart }}
</section>

<section>
  <h2>Time per thread this week</h2>
  <div class="legend">{{ group_legend }}</div>
  <div class="bars">
  {% for b in threads %}
    <div><div class="bar-label"><span>{{ b.label }}</span><span>{{ b.text }}</span></div>
    <div class="bar-track"><div class="bar-fill {{ b.css }}" style="width:{{ "%.1f" | format(b.pct) }}%"></div></div></div>
  {% endfor %}
  </div>
</section>

<footer>Generated by focus-tracker.</footer>
</main>
</body>
</html>
