# Copy to ~/.config/focus-tracker/.env and fill in. Never commit the real file.

# Telegram bot token from @BotFather, e.g. 123456789:AA...
TELEGRAM_BOT_TOKEN=

# Your numeric chat ID with the bot (see README: "Telegram setup")
TELEGRAM_CHAT_ID=

# Optional: enables LLM classification of window titles the rules don't match.
# Leave empty for rules-only mode (nothing is sent to the Claude API).
ANTHROPIC_API_KEY=
